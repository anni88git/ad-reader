# Copy this file to ".env" and fill in values. NEVER commit .env or paste keys into chat.

# Which vision-language backend to use:
#   "nvidia"    - NVIDIA API Catalog (build.nvidia.com), free with NVIDIA Developer Program, works from India
#   "local"     - self-hosted vLLM / OpenAI-compatible server (e.g. Qwen3-VL-8B on Kaggle GPU)
#   "dashscope" - Alibaba Model Studio (not available for India-registered accounts)
VLM_BACKEND=nvidia

# --- NVIDIA API Catalog ---
NVIDIA_API_KEY=
NVIDIA_API_KEY_BACKUP=    # optional: used automatically if the main key is rejected or rate-limited
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Exact model IDs to be confirmed from the build.nvidia.com catalog
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VERIFIER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Alibaba Cloud Model Studio (Singapore region, enable "Free Quota Only") ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-vl-plus
# Second-opinion model used for cross-checking (disagreement => flag for review)
DASHSCOPE_VERIFIER_MODEL=qwen2.5-vl-72b-instruct

# --- Local / self-hosted OpenAI-compatible server (optional) ---
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=not-needed
LOCAL_MODEL=Qwen/Qwen3-VL-8B-Instruct
